<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Review Order & Cart - Grand Palace Hotel</title>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
/* =========================================================
   GRAND PALACE — LUXURY IVORY & CHAMPAGNE GOLD
   Cart / Checkout Theme
   ========================================================= */

:root {
    --bg: #f7f3e8;
    --card-bg: #fffdf7;
    --card-soft: #f4efe2;

    --border: #d8c99a;
    --border-light: #e8dfc5;

    --text: #29251d;
    --muted: #756f63;

    --gold: #b8953f;
    --gold-dark: #927326;
    --gold-light: #d8bd70;

    --success: #b8953f;
    --danger: #b94a48;
}

/* ---------- GLOBAL ---------- */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family:
        "Segoe UI",
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        sans-serif;
}

html {
    background: var(--bg);
}

body {
    background:
        radial-gradient(
            circle at top,
            #fffdf7 0%,
            #f7f3e8 55%,
            #f1ead9 100%
        );

    color: var(--text);

    min-height: 100vh;

    padding: 1.5rem 1rem 4rem;
}

/* ---------- CONTAINER ---------- */

.container {
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
}

/* ---------- HEADER ---------- */

.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    margin-bottom: 1.5rem;
}

.header h1,
.header h2 {
    color: var(--text);
}

/* ---------- BACK BUTTON ---------- */

.back-btn {
    color: var(--gold-dark) !important;

    text-decoration: none;

    font-size: 1rem;
    font-weight: 600;

    transition: color 0.2s ease;
}

.back-btn:hover {
    color: var(--gold) !important;
}

/* ---------- CART LIST ---------- */

.cart-list {
    display: flex;
    flex-direction: column;

    gap: 0.9rem;

    margin-bottom: 1.5rem;
}

/* ---------- CART ITEM ---------- */

.cart-row {
    background: rgba(255, 253, 247, 0.96) !important;

    border: 1px solid var(--border) !important;

    border-radius: 16px !important;

    padding: 0.9rem;

    display: flex;
    align-items: center;

    gap: 1rem;

    box-shadow:
        0 3px 12px rgba(105, 83, 30, 0.08),
        0 1px 3px rgba(0, 0, 0, 0.03);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;
}

.cart-row:hover {
    transform: translateY(-1px);

    border-color: var(--gold-light) !important;

    box-shadow:
        0 6px 18px rgba(105, 83, 30, 0.12);
}

/* ---------- FOOD IMAGE ---------- */

.item-thumb {
    width: 64px !important;
    height: 64px !important;

    border-radius: 10px !important;

    object-fit: cover;

    border: 1px solid var(--border-light);
}

/* ---------- ITEM DETAILS ---------- */

.item-details {
    flex: 1;
    min-width: 0;
}

.item-details h3,
.item-details h4,
.item-details strong {
    color: var(--text);
}

.item-details p,
.item-details span {
    color: var(--muted);
}

/* ---------- QUANTITY ---------- */

.item-qty-badge {
    background: var(--card-soft) !important;

    color: var(--text) !important;

    border: 1px solid var(--border) !important;

    padding: 0.35rem 0.65rem;

    border-radius: 8px;

    font-size: 0.85rem;

    white-space: nowrap;
}

/* ---------- ITEM PRICE ---------- */

.item-line-total {
    font-weight: 800;

    color: var(--gold-dark) !important;

    min-width: 85px;

    text-align: right;

    white-space: nowrap;
}

/* ---------- BILL CARD ---------- */

.bill-card {
    background: rgba(255, 253, 247, 0.98) !important;

    color: var(--text) !important;

    border: 1px solid var(--border) !important;

    border-radius: 18px !important;

    padding: 1.4rem;

    box-shadow:
        0 5px 20px rgba(105, 83, 30, 0.09);
}

/* ---------- BILL TOTAL ---------- */

.bill-total {
    display: flex;

    justify-content: space-between;

    align-items: center;

    font-size: 1.35rem;

    font-weight: 800;

    color: var(--text);

    border-top: 1px dashed var(--border) !important;

    padding-top: 1rem;

    margin-top: 1rem;
}

.bill-total strong,
.bill-total span {
    color: var(--gold-dark) !important;
}

/* ---------- BUTTONS ---------- */

.action-btn {
    width: 100%;

    background:
        linear-gradient(
            135deg,
            #c4a34d,
            #a7832f
        ) !important;

    color: #fffdf7 !important;

    border: 1px solid #a7832f !important;

    border-radius: 12px !important;

    padding: 1rem;

    font-size: 1.05rem;

    font-weight: 700;

    cursor: pointer;

    box-shadow:
        0 5px 15px rgba(168, 132, 47, 0.25);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        filter 0.2s ease;
}

.action-btn:hover {
    filter: brightness(1.04);

    transform: translateY(-1px);

    box-shadow:
        0 7px 20px rgba(168, 132, 47, 0.30);
}

.action-btn:active {
    transform: translateY(0);
}

/* ---------- ALL COMMON BUTTONS ---------- */

button {
    font-family: inherit;
}

button:not(.action-btn) {
    color: var(--gold-dark);
}

/* ---------- LINKS ---------- */

a {
    color: var(--gold-dark);
}

/* ---------- INPUTS ---------- */

input,
select,
textarea {
    background: #fffdf7 !important;

    color: var(--text) !important;

    border: 1px solid var(--border) !important;

    border-radius: 8px;
}

input:focus,
select:focus,
textarea:focus {
    outline: none;

    border-color: var(--gold) !important;

    box-shadow:
        0 0 0 2px rgba(184, 149, 63, 0.12);
}

/* ---------- RAZORPAY / PAYMENT AREAS ---------- */

.payment-section,
.payment-card {
    background: var(--card-bg);
    border-color: var(--border);
}

/* ---------- MOBILE ---------- */

@media (max-width: 600px) {

    body {
        padding:
            1rem
            0.75rem
            3rem;
    }

    .container {
        width: 100%;
    }

    .header {
        margin-bottom: 1.1rem;
    }

    .header h1 {
        font-size: 1.8rem;
    }

    .header h2 {
        font-size: 1.5rem;
    }

    .cart-row {
        gap: 0.7rem;

        padding: 0.75rem;

        border-radius: 14px !important;
    }

    .item-thumb {
        width: 58px !important;
        height: 58px !important;
    }

    .item-line-total {
        min-width: 70px;

        font-size: 0.95rem;
    }

    .item-qty-badge {
        padding: 0.3rem 0.5rem;

        font-size: 0.8rem;
    }

    .bill-card {
        padding: 1.1rem;

        border-radius: 16px !important;
    }

    .bill-total {
        font-size: 1.2rem;
    }

    .action-btn {
        padding: 0.9rem;

        font-size: 1rem;
    }
}

/* ---------- SMALL PHONES ---------- */

@media (max-width: 400px) {

    body {
        padding-left: 0.6rem;
        padding-right: 0.6rem;
    }

    .cart-row {
        gap: 0.55rem;
    }

    .item-thumb {
        width: 52px !important;
        height: 52px !important;
    }

    .item-line-total {
        min-width: 62px;

        font-size: 0.88rem;
    }

    .item-qty-badge {
        font-size: 0.76rem;
    }
}
#timerBox { display: none !important; }
#timerBox.timer-visible { display: block !important; }


/* ---------- KITCHEN WAITING TIMER ---------- */
#timerBox {
    display: none !important;
    width: 100%;
    margin-top: 10px;
    padding: 16px 12px;
    text-align: center;
    background: linear-gradient(135deg, #d8bd70, #b8953f);
    border: 1px solid #927326;
    border-radius: 14px;
    box-sizing: border-box;
}

#timerBox.timer-visible {
    display: block !important;
}

#timerBox h3 {
    margin: 0 0 8px;
    color: #fffdf7;
    font-size: 1rem;
    font-weight: 700;
}

#timerBox .timer-val {
    font-size: 1.8rem;
    font-weight: 800;
    color: #fffdf7;
    letter-spacing: 1px;
    line-height: 1.2;
}

</style>
</head>
<body>

<div class="container">
    <div class="header">
        <a href="/menu" class="back-btn">← Back to Menu</a>
        <h2>Checkout & Confirm</h2>
    </div>

    <div class="cart-list" id="cartItemsList"></div>

    <div class="bill-card" id="billBox" style="display:none;">
        <div class="bill-total">
            <span>To Pay</span>
            <span id="totalPayableLabel">₹0.00</span>
        </div>

        <!-- Hidden until Place Order is clicked -->

        <!-- Dynamic Two-Stage Button -->
        <button class="action-btn" id="mainActionButton" onclick="handleActionButtonClick()">Place Order & Await Acceptance</button>

<div class="timer-box" id="timerBox" style="display:none;">
    <h3 id="timerHeader">Waiting for Kitchen to Accept</h3>
    <div class="timer-val" id="timerDisplay">01:00</div>
</div>
    </div>
</div>

<script>


    let cartTotal = 0;
    let submittedOrderId = null;
    let currentActiveOrder = null;
    let timerInterval = null;
    let pollInterval = null;
    let secondsLeft = 60;
    let orderState = "cart"; // "cart" | "awaiting_acceptance" | "accepted_unpaid"
    let cancellationHandled = false;

    async function handleKitchenCancellation(data) {
        if (cancellationHandled) return;
        cancellationHandled = true;

        console.log("KITCHEN CANCELLATION RECEIVED:", data);

        // STOP EVERYTHING IMMEDIATELY
        clearInterval(timerInterval);
        clearInterval(pollInterval);

        timerInterval = null;
        pollInterval = null;

        secondsLeft = 0;
        orderState = "cart";
        currentActiveOrder = null;
        submittedOrderId = null;

        // Hide waiting timer
        const timerBox = document.getElementById('timerBox');
        if (timerBox) {
            timerBox.classList.remove('timer-visible');
            timerBox.style.display = 'none';
        }

        // Reset main button
        const btn = document.getElementById('mainActionButton');
        if (btn) {
            btn.disabled = false;
            btn.className = "action-btn";
            btn.textContent = "Place Order & Await Acceptance";
        }

        // Show cancellation notification
        const reason = data.reason || "The kitchen cancelled your order.";

        alert(
            "ORDER CANCELLED BY KITCHEN\n\n" +
            "Your order was cancelled by the kitchen.\n\n" +
            "Reason: " + reason
        );

        // Acknowledge the server alert
        try {
            await fetch('/api/order/ack-alert', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    order_id: data.order_id
                })
            });
        } catch (e) {
            console.error("Cancellation acknowledgement failed:", e);
        }

        // Return customer to menu
        window.location.replace("/menu");
    }

    async function loadCartData() {
        // 1. Check existing order state on server first
        const statusRes = await fetch('/api/order/active');
        const statusData = await statusRes.json();

        // Kitchen cancelled the order
        if (statusData.alert && statusData.status === 'cancelled') {
            await handleKitchenCancellation(statusData);
            return;
        }

        // Case A: Order already submitted, awaiting kitchen acceptance within 60s
        if (statusData.has_active_order && statusData.status === 'placed') {
            submittedOrderId = statusData.order_id;
            currentActiveOrder = statusData;
            secondsLeft = statusData.seconds_left !== undefined ? statusData.seconds_left : 60;
            orderState = "awaiting_acceptance";

            await renderCartItems();
            setAwaitingAcceptanceUI();
            return;
        }

        // Case B: Kitchen already accepted, but user hasn't paid yet!
        if (statusData.has_active_order && statusData.status !== 'placed' && statusData.payment_status !== 'paid') {
            submittedOrderId = statusData.order_id;
            currentActiveOrder = statusData;
            orderState = "accepted_unpaid";

            await renderCartItems();
            setPayNowUI();
            return;
        }

        // Case C: Standard fresh cart
        orderState = "cart";
        await renderCartItems();
    }

    async function renderCartItems() {
        const res = await fetch('/api/cart/items');
        const data = await res.json();
        const list = document.getElementById('cartItemsList');
        const billBox = document.getElementById('billBox');

        if (!data.items || data.items.length === 0) {
            list.innerHTML = '<p style="text-align:center; color:var(--muted); padding:3rem;">Your cart is empty.</p>';
            billBox.style.display = 'none';
            return;
        }

        cartTotal = data.total_price;
        list.innerHTML = '';
        data.items.forEach(item => {
            list.innerHTML += `
                <div class="cart-row">
                    <img src="${item.photo_url}" class="item-thumb" alt="${item.item_name}" onerror="this.src='https://via.placeholder.com/48'">
                    <div class="item-details">
                        <h4>${item.item_name}</h4>
                        <div style="font-size:0.75rem; color:var(--muted); text-transform:capitalize;">${item.category}</div>
                    </div>
                    <div class="item-qty-badge">${item.quantity} pcs</div>
                    <div class="item-line-total">₹${item.line_total.toFixed(2)}</div>
                </div>
            `;
        });

        document.getElementById('totalPayableLabel').textContent = `₹${cartTotal.toFixed(2)}`;
        billBox.style.display = 'block';
    }

    // Controls the single primary button's click behavior
    function handleActionButtonClick() {
        if (orderState === "cart") {
            requestOrderAcceptance();
        } else if (orderState === "accepted_unpaid") {
            launchPaymentFlow(currentActiveOrder);
        }
    }

    // Step 1: User clicks "Place Order & Await Acceptance"
    async function requestOrderAcceptance() {
        const btn = document.getElementById('mainActionButton');
        btn.disabled = true;
        btn.textContent = "Submitting to Kitchen...";

        try {
            const res = await fetch('/api/order/submit-request', { method: 'POST' });
            const data = await res.json();

            if (!res.ok) {
                alert(data.error || "Order submission failed");
                btn.disabled = false;
                btn.textContent = "Place Order & Await Acceptance";
                return;
            }

            submittedOrderId = data.order_id;
            orderState = "awaiting_acceptance";
            secondsLeft = 60;

            setAwaitingAcceptanceUI();

        } catch (err) {
            alert("Network error submitting order");
            btn.disabled = false;
            btn.textContent = "Place Order & Await Acceptance";
        }
    }

    function setAwaitingAcceptanceUI() {
        const btn = document.getElementById('mainActionButton');
        const timerBox = document.getElementById('timerBox');

        // Show waiting timer ONLY while kitchen is deciding
        timerBox.classList.add('timer-visible');

        btn.disabled = true;
        btn.className = "action-btn";
        btn.textContent = "Awaiting Kitchen Acceptance...";

        updateTimerDisplay();

        clearInterval(timerInterval);
        clearInterval(pollInterval);

        timerInterval = setInterval(handleTimerTick, 1000);
        pollInterval = setInterval(checkIfAccepted, 2000);
    }

    function setPayNowUI() {
        // STOP both timers immediately
        clearInterval(timerInterval);
        clearInterval(pollInterval);

        timerInterval = null;
        pollInterval = null;

        // COMPLETELY HIDE the waiting timer after kitchen accepts
        const timerBox = document.getElementById('timerBox');
        timerBox.classList.remove('timer-visible');

        const btn = document.getElementById('mainActionButton');

        btn.disabled = false;
        btn.className = "action-btn btn-pay-now";
        btn.textContent =
            `Pay Now (Accepted) - ₹${currentActiveOrder ? currentActiveOrder.total_amount.toFixed(2) : cartTotal.toFixed(2)}`;
    }

    function updateTimerDisplay() {
        const mins = String(Math.floor(secondsLeft / 60)).padStart(2, '0');
        const secs = String(secondsLeft % 60).padStart(2, '0');

        document.getElementById('timerDisplay').textContent =
            `${mins}:${secs}`;
    }

    function handleTimerTick() {
        secondsLeft--;

        if (secondsLeft <= 0) {
            clearInterval(timerInterval);
            clearInterval(pollInterval);

            timerInterval = null;
            pollInterval = null;

            document.getElementById('timerBox').classList.remove('timer-visible');

            handleTimeoutCancellation();
            return;
        }

        updateTimerDisplay();
    }

    async function checkIfAccepted() {
        try {
            const res = await fetch('/api/order/active');
            const data = await res.json();

            console.log("ORDER STATUS POLL:", data);

            // =====================================================
            // KITCHEN CANCELLED THE ORDER
            // =====================================================
            if (data.alert && data.status === 'cancelled') {
                await handleKitchenCancellation(data);
                return;
            }

            // =====================================================
            // KITCHEN ACCEPTED THE ORDER
            // =====================================================
            if (
                data.has_active_order &&
                data.order_id === submittedOrderId &&
                data.status !== 'placed'
            ) {
                currentActiveOrder = data;
                orderState = "accepted_unpaid";

                // Stop timer and polling immediately
                setPayNowUI();
                return;
            }

        } catch (e) {
            console.error("Order status polling error:", e);
        }
    }

    async function handleTimeoutCancellation() {
        await fetch('/api/order/timeout-cancel', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ order_id: submittedOrderId })
        });
        alert("The kitchen is not accepting orders, please try again in a few minutes.");
        window.location.href = "/menu";
    }

    // Step 2: User clicks "Pay Now (Accepted)"
    // Read the test_mode variable passed from Flask
    const IS_TEST_MODE = "{{ 'true' if test_mode else 'false' }}" === "true";
    const RZP_KEY_ID = "{{ rzp_key }}";
    const USER_EMAIL = "{{ email }}";
    const USER_NAME = "{{ username }}";

    // ... (rest of your variables and functions stay identical) ...

    async function launchPaymentFlow(orderData) {
        // --- 1. IF IN TEST MODE: BYPASS RAZORPAY GATEWAY ENTIRELY ---
        if (IS_TEST_MODE) {
            const confirmTest = confirm(`Kitchen Accepted Order #${orderData.daily_order_number}!\n\n[TEST MODE] Click OK to place order and confirm test payment of ₹${orderData.total_amount.toFixed(2)}.`);
            
            if (confirmTest) {
                try {
                    const payRes = await fetch('/api/payment/confirm-test', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ order_id: orderData.order_id })
                    });
                    const payData = await payRes.json();
                    
                    if (payData.success) {
                        alert("✅ Test Payment Successful! Your order has been placed.");
                        window.location.href = "/menu";
                    } else {
                        alert("❌ Failed to record test payment.");
                    }
                } catch (err) {
                    alert("Network error confirming test payment.");
                }
            } else {
                alert("Payment was not completed. The order placed button will not activate until payment is complete.");
                window.location.href = "/menu";
            }
            return;
        }

        // --- 2. REAL RAZORPAY GATEWAY (Only runs when test_mode is False) ---
        const options = {
            "key": RZP_KEY_ID,
            "amount": Math.round(orderData.total_amount * 100),
            "currency": "INR",
            "name": "Grand Palace Hotel",
            "description": `Token #${orderData.daily_order_number}`,
            "order_id": orderData.gateway_order_id,
            "prefill": { "name": USER_NAME, "email": USER_EMAIL },
            "theme": { "color": "#0284c7" },
            "handler": async function (response) {
                const verifyRes = await fetch('/api/payment/verify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        razorpay_order_id: response.razorpay_order_id,
                        razorpay_payment_id: response.razorpay_payment_id,
                        razorpay_signature: response.razorpay_signature
                    })
                });
                const verifyData = await verifyRes.json();
                if (verifyData.success) {
                    alert("Payment Verified! Your order is placed.");
                    window.location.href = "/menu";
                } else {
                    alert("Payment verification failed");
                }
            },
            "modal": {
                "ondismiss": function() {
                    alert("Payment cancelled. Order placed button will not activate until payment is complete.");
                    window.location.href = "/menu";
                }
            }
        };

        const rzp = new Razorpay(options);
        rzp.open();
    }

    loadCartData();
</script>

